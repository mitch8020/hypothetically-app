{
  "version": "1.0.0",
  "paths": {
    "projectRoot": "C:/Projects/Hypothetically App/hypothetically-app",
    "worktreesRoot": "worktrees"
  },
  "repos": {
    "backend": {
      "path": "hypothetically-app-backend",
      "envFile": ".env",
      "envProfiles": {
        "dev": "hypothetically-app-backend/.env.dev",
        "prod": "hypothetically-app-backend/.env.prod"
      }
    },
    "frontend": {
      "path": "hypothetically-app-frontend",
      "envFile": ".env",
      "envProfiles": {
        "dev": "hypothetically-app-frontend/.env.dev",
        "prod": "hypothetically-app-frontend/.env.prod"
      }
    }
  },
  "commands": {
    "backend": {
      "dev": [
        [
          "npm",
          "run",
          "start:dev"
        ]
      ],
      "prod": [
        [
          "npm",
          "run",
          "build"
        ],
        [
          "npm",
          "run",
          "start:prod"
        ]
      ]
    },
    "frontend": {
      "dev": [
        [
          "npm",
          "run",
          "dev",
          "--",
          "--strictPort",
          "--port",
          "${ports.frontend}"
        ]
      ],
      "prod": [
        [
          "npm",
          "run",
          "build"
        ],
        [
          "npm",
          "run",
          "preview",
          "--",
          "--strictPort",
          "--port",
          "${ports.frontend}"
        ]
      ]
    }
  },
  "git": {
    "defaults": {
      "syncSource": "development",
      "devSource": "development",
      "mainFlow": {
        "development": "development",
        "qa": "qa",
        "main": "main"
      }
    },
    "targets": {},
    "groups": {}
  },
  "deploy": {
    "targets": {
      "dev": {
        "envProfile": "dev",
        "ports": {
          "backend": 7000,
          "frontend": 7073
        }
      },
      "prod": {
        "envProfile": "prod",
        "ports": {
          "backend": 8000,
          "frontend": 8073
        }
      }
    },
    "envOverrides": {
      "backend": {
        "PORT": "${ports.backend}"
      },
      "frontend": {
        "PORT": "${ports.frontend}"
      }
    }
  },
  "worktrees": {
    "configPath": "worktrees/config/worktree-config.json"
  },
  "project": {
    "name": "Hypothetically App",
    "slug": "hypothetically-app"
  }
}
